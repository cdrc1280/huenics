{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "^/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "^/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "^/fonts/(.*)",
            "dest": "/fonts/$1"
        },
        {
            "src": "^/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "^/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "^/favicon\\.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "^/robots\\.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "local",
        "APP_DEBUG": "true",
        "APP_URL": "https://huenics.vercel.app",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr"
    }
}